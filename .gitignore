# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
htmlcov/
.coverage
*.cover
coverage.xml

# Data (user-specific)
data/

# IDE / Tools
.claude/
.vscode/

# Bench — the lookup cache is a local artifact; the demo seed, prompts and
# runs are kept because they are the evidence behind bench/comparison.md and
# bench/verification.md.
bench/.verify_cache.json

# Personal seeds: a dump of someone's actual collection or playlist is their
# listening history. Keep it local unless you decide otherwise. The demo seed
# (bench/seeds/demo_playlist.txt) is committed; your own exports are not.
bench/seeds/*.json
!bench/seeds/demo_*.json

# Other household members' data. Publishing your own listening is your call to
# make; publishing someone else's is not. Anything belonging to another
# account on this install stays local.
bench/seeds/bee_*
bench/channel_18427c38.json
bench/channel_a143ea7d.json
