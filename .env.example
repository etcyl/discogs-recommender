# All keys are OPTIONAL — the app works without any of them.
# Leave blank or remove lines you don't need.

# Discogs (optional) — enables collection-based recommendations.
# If your collection is PUBLIC, the username alone is enough: a public
# collection is readable over the Discogs API with no token at all.
# A token is only needed for a private collection, or for the genre/style
# engine, which searches the Discogs catalogue.
DISCOGS_USERNAME=
# DISCOGS_TOKEN=          # https://www.discogs.com/settings/developers

# Claude AI (optional) — cloud-based AI recommendations
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Ollama (optional) — free local AI (default: http://localhost:11434)
# Install from https://ollama.com, then: ollama pull llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Prompt depth for local models: auto | compact | rich
# "auto" gives Ollama the short prompt meant for 8B-class models. Set "rich"
# if you run something in the 24B+ range — it gets the full curator prompt.
# PROMPT_TIER=auto

# --- Accuracy and guardrails (see docs/SAFETY.md) --------------------------

# How hard to fact-check AI recommendations against public music catalogues
# before showing them:
#   off    — no checking, you are trusting the model
#   flag   — everything shown, unconfirmed songs badged  (default)
#   strict — unconfirmed songs are dropped before you see them
# VERIFICATION_POLICY=flag

# Record every generation — model, settings, and each song's verification
# outcome — to the audit log at /audit.
# AUDIT_ENABLED=true
# AUDIT_RETENTION_DAYS=90

# Move all on-disk state (database, per-user JSON) somewhere else.
# DISCOGS_DATA_DIR=

# --- Sharing on your home network (see docs/SAFETY.md) ---------------------

# Let other people on the same network sign in with a username and password.
# Each account gets its own playlists, likes, history and audit log.
# You must ALSO start the server with --host 0.0.0.0:
#     uvicorn app:app --port 8000 --host 0.0.0.0
# This does not expose anything to the internet. Do not port-forward it —
# sign-in is over plain HTTP, which is fine on a LAN you control and not
# anywhere else.
# LAN_ACCESS=false

# Extra hostnames the app will answer to, comma separated. Private IPs are
# accepted automatically when LAN_ACCESS is on.
# EXTRA_ALLOWED_HOSTS=

# Only turn on behind a reverse proxy you run. X-Forwarded-For is supplied by
# the caller, so trusting it without a proxy lets anyone claim a local address
# and get the owner's automatic sign-in.
# TRUST_PROXY_HEADERS=false

# Session secret (optional) — auto-generated if not set
# Sessions won't survive app restarts without this
# SECRET_KEY=
